# /etc/nginx/sites-available/gh-telemetry — подставьте свой домен; сертификат выпустит certbot
limit_req_zone $binary_remote_addr zone=gh_hb:1m rate=30r/m;
limit_req_zone $binary_remote_addr zone=gh_admin:1m rate=20r/m;

server {
    listen 80;
    server_name pf.kzpm.org;
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name pf.kzpm.org;
    # ssl_certificate / ssl_certificate_key добавит certbot

    client_max_body_size 4k;

    location = /api/v1/hb {
        limit_req zone=gh_hb burst=20 nodelay;
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header X-Real-IP $remote_addr;      # внешний IP контроллера
    }
    location /admin {
        limit_req zone=gh_admin burst=20 nodelay;
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header X-Real-IP $remote_addr;
        # по желанию — только с ваших адресов:
        # allow 203.0.113.10; deny all;
    }
    location / { return 404; }
}
